# Your BotFather token. Never commit the real value.
BOT_TOKEN=your_token_here

# Optional: SQLite is the default (bot.db in this folder). For Postgres, use e.g.:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=

# Your personal Telegram numeric user ID (message @userinfobot to get it).
# Required for /broadcast — only this ID may use it.
OWNER_ID=

# --- Deployment / webhook mode ---
# Leave both empty for local polling (what you use on your PC).
# On Render/Railway/etc, set WEBHOOK_URL to your service's public HTTPS URL
# (e.g. https://your-app.onrender.com) and the bot switches to webhook mode
# automatically. PORT is provided automatically by most hosts; 8080 is a
# safe local default.
WEBHOOK_URL=
PORT=8080
